# OpenAI
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=ask-profile
PINECONE_NAMESPACE=resume

# Models
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Candidate identity
CANDIDATE_NAME=Bantu Sagar Kumar
CANDIDATE_SHORT_NAME=Bantu
LINKEDIN_URL=https://www.linkedin.com/in/your-profile

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_DEFAULT=30/minute

# LangSmith (tracing / observability)
# Get an API key at https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=ask-bantu
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Frontend (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_CANDIDATE_NAME=Bantu Sagar Kumar
# NEXT_PUBLIC_CANDIDATE_SHORT_NAME=Bantu
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
